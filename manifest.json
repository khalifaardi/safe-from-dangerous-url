{
  "manifest_version": 3,
  "name": "CekDulu — link check sebelum klik",
  "version": "0.1.0",
  "description": "Lihat link sebelum kamu klik. Cek lokal, tanpa mengirim URL ke mana-mana secara default.",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "src/background.js" },
  "action": {
    "default_title": "CekDulu",
    "default_popup": "popup.html",
    "default_icon": { "128": "icons/icon128.png" }
  },
  "icons": { "128": "icons/icon128.png" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/engine.js", "src/content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
